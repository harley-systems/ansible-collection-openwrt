# DNS provider credentials for ACME DNS-01 challenge
# Managed by Ansible - do not edit manually
{% if acme_dns_provider == 'dns_cf' %}
# Cloudflare credentials
export CF_Token='{{ acme_cf_token }}'
export CF_Zone_ID='{{ acme_cf_zone_id }}'
{% elif acme_dns_provider == 'dns_gd' %}
# GoDaddy credentials
export GD_Key='{{ acme_gd_key }}'
export GD_Secret='{{ acme_gd_secret }}'
{% elif acme_dns_provider == 'dns_aws' %}
# AWS Route53 credentials
export AWS_ACCESS_KEY_ID='{{ acme_aws_access_key }}'
export AWS_SECRET_ACCESS_KEY='{{ acme_aws_secret_key }}'
{% else %}
# Generic credentials - customize as needed
{% for key, value in (acme_credentials | default({})).items() %}
export {{ key }}='{{ value }}'
{% endfor %}
{% endif %}
