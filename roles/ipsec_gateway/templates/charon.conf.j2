# charon.conf - Charon daemon configuration
# Managed by Ansible (ipsec_gateway role) - do not edit manually
#
# This file overrides select charon settings. All other settings
# use Ubuntu package defaults (no need to ship 78 plugin configs).

    # Reuse existing IKE_SAs when initiating new CHILD_SAs
    reuse_ikesa = yes

    # Install routes for established IPsec tunnels
    install_routes = no

    # Disable the constraints plugin to work around a bug in StrongSwan
    # 5.9.13 (Ubuntu 24.04) where Name Constraints validation uses AND
    # instead of OR semantics across permitted constraints (fixed in 5.9.14).
    # Name Constraints remain enforced in the X.509 certificates themselves.
    plugins {
        constraints {
            load = no
        }
    }
