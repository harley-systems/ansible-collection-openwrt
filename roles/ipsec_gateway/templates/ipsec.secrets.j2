# ipsec.secrets - StrongSwan secrets file
# Managed by Ansible - do not edit manually

{% if ipsec_rsa_key %}
# RSA private key for certificate authentication
: RSA {{ ipsec_rsa_key }}
{% endif %}

{% for psk in ipsec_psk_secrets %}
# PSK for {{ psk.local }} <-> {{ psk.remote }}
{{ psk.local }} {{ psk.remote }} : PSK "{{ psk.secret }}"
{% endfor %}
