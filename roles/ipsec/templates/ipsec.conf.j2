# ipsec.conf - StrongSwan IPsec configuration file
# Managed by Ansible - do not edit manually

config setup
    charondebug="{{ ipsec_charondebug }}"
    uniqueids = {{ "yes" if ipsec_uniqueids else "no" }}

conn %default
    keyexchange=ikev2
    ike={{ ipsec_ike_default | regex_replace('\s+', '') }}
    esp={{ ipsec_esp_default | regex_replace('\s+', '') }}

    dpdaction={{ ipsec_dpdaction }}
    dpddelay={{ ipsec_dpddelay }}

    leftauth={{ ipsec_leftauth }}
    rightauth={{ ipsec_rightauth }}

    auto=add

{% for conn in ipsec_connections %}
# =============================================================================
# {{ conn.name }}
# =============================================================================
conn {{ conn.name }}
{% if conn.enabled is defined %}
    auto={{ conn.enabled }}
{% endif %}
{% if conn.mark is defined %}
    mark={{ conn.mark }}
{% endif %}
{% if conn.type is defined %}
    type={{ conn.type }}
{% endif %}
{#
  Per-connection DPD override. A road-warrior responder serving mobile clients
  usually wants dpdaction=none: a sleeping phone stops sending NAT-T keepalives,
  its carrier NAT binding expires, and DPD probes to the now-stale port go
  nowhere - so the responder tears down a tunnel the client still believes is
  up, and the user sees "connected but no internet". Always-on site-to-site
  peers still want liveness detection, hence a per-connection override rather
  than changing the global default.
#}
{% if conn.dpdaction is defined %}
    dpdaction={{ conn.dpdaction }}
{% endif %}
{% if conn.dpddelay is defined %}
    dpddelay={{ conn.dpddelay }}
{% endif %}
{#
  Renegotiation control. Same failure mode as DPD above, different trigger: any
  exchange the responder INITIATES will go unanswered while the client sleeps
  behind an expired NAT binding, and after 5 retransmits strongSwan tears the
  tunnel down. Disabling DPD only removes one such exchange - CHILD_SA rekey and
  IKE reauthentication remain, and both fire on fixed timers.

  rekey=no stops this responder requesting renegotiation while still honouring
  rekeys requested by the peer, so an awake client drives them. reauth=no avoids
  full reauthentication (IKEv2 rekeys the IKE_SA instead). Generous lifetimes
  keep hard expiry rare so the client, which uses shorter defaults, always
  renegotiates first while it is actually awake and passing traffic.
#}
{% if conn.rekey is defined %}
    rekey={{ conn.rekey }}
{% endif %}
{% if conn.reauth is defined %}
    reauth={{ conn.reauth }}
{% endif %}
{% if conn.ikelifetime is defined %}
    ikelifetime={{ conn.ikelifetime }}
{% endif %}
{% if conn.keylife is defined %}
    keylife={{ conn.keylife }}
{% endif %}

    # Left (local) side
{% if conn.left is defined %}
    left={{ conn.left }}
{% endif %}
{% if conn.leftid is defined %}
    leftid="{{ conn.leftid }}"
{% endif %}
{% if conn.leftsubnet is defined %}
    leftsubnet={{ conn.leftsubnet }}
{% endif %}
{% if conn.leftcert is defined %}
    leftcert={{ conn.leftcert }}
{% endif %}
{% if conn.leftsendcert is defined %}
    leftsendcert={{ conn.leftsendcert }}
{% endif %}
{% if conn.leftsourceip is defined %}
    leftsourceip={{ conn.leftsourceip }}
{% endif %}
{% if conn.leftupdown is defined %}
    leftupdown="{{ conn.leftupdown }}"
{% endif %}

    # Right (remote) side
{% if conn.right is defined %}
    right={{ conn.right }}
{% endif %}
{% if conn.rightid is defined %}
    rightid="{{ conn.rightid }}"
{% endif %}
{% if conn.rightsubnet is defined %}
    rightsubnet={{ conn.rightsubnet }}
{% endif %}
{% if conn.rightcert is defined %}
    rightcert={{ conn.rightcert }}
{% endif %}
{% if conn.rightsourceip is defined %}
    rightsourceip={{ conn.rightsourceip }}
{% endif %}
{% if conn.rightdns is defined %}
    rightdns={{ conn.rightdns }}
{% endif %}
{% if conn.rightca is defined %}
    rightca="{{ conn.rightca }}"
{% endif %}

{% endfor %}
